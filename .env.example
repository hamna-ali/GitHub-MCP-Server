# GitHub Personal Access Token (classic or fine-grained)
# Permissions required:
#   - Fine-grained token: "Public Repositories (read-only)" or "Repository access: Read-only on contents and metadata"
#   - Classic token: "public_repo" (or "repo" if analyzing private repositories)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# Optional: Custom GitHub API URL (defaults to https://api.github.com)
GITHUB_API_URL=https://api.github.com
